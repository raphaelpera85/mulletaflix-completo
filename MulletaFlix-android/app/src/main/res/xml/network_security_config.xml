<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security config for MulletaFlix Android.

    Allows cleartext HTTP traffic because MulletaFlix servers may be exposed
    over HTTP (including the configured DuckDNS endpoint and LAN addresses).

    HTTPS is ALWAYS preferred when available and required for external servers.
    This mirrors the Jellyfin Android approach.
-->
<network-security-config>
    <!-- Public HTTP endpoint configured for this installation. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">mulletaflix.duckdns.org</domain>
    </domain-config>

    <!-- Allow HTTP for self-hosted LAN servers discovered at runtime. Android's
         network security XML cannot express dynamic CIDR ranges. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

</network-security-config>
