<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security config for MulletaFlix Android.

    Android's XML cannot express dynamic LAN CIDRs, so cleartext remains enabled
    at the platform layer for local servers. App HTTP clients enforce the local
    host policy before credentials and on every redirected request.
-->
<network-security-config>
    <!-- The public server must always use HTTPS; LAN discovery uses local IPs. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">mulletaflix.duckdns.org</domain>
    </domain-config>

    <!-- Allow HTTP for self-hosted LAN servers discovered at runtime. Android's
         network security XML cannot express dynamic CIDR ranges. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

</network-security-config>
