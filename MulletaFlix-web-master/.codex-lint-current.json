    };\n\n        self.previousTrack = function (player: any) {\n            player = player || self._currentPlayer;\n            if (player && !enableLocalPlaylistManagement(player)) {\n                return player.previousTrack();\n            }\n\n            const newIndex = self.getCurrentPlaylistIndex(player) - 1;\n            if (newIndex >= 0) {\n                const playlist = self._playQueueManager.getPlaylist();\n                const newItem = playlist[newIndex];\n\n                if (newItem) {\n                    const newItemPlayOptions = newItem.playOptions || getDefaultPlayOptions();\n                    newItemPlayOptions.startPositionTicks = 0;\n\n                    void playInternal(newItem, newItemPlayOptions, function () {\n                        setPlaylistState(newItem.PlaylistItemId, newIndex);\n                    }, getPreviousSource(player)).catch((error: unknown) => console.error('Failed to play previous track', error));\n                }\n            }\n        };\n\n        self.queue = function (options: any, player: any = this._currentPlayer) {\n            return queue(options, '', player);\n        };\n\n        self.queueNext = function (options: any, player: any = this._currentPlayer) {\n            return queue(options, 'next', player);\n        };\n\n        function queue(options, mode, player) {\n            player = player || self._currentPlayer;\n\n            if (!player) {\n                return self.play(options);\n            }\n\n            if (options.items) {\n                return translateItemsForPlayback(options.items, options).then(function (translated: any) {\n                    queueAll(translated.items, mode, player, translated.startIndex ?? options.startIndex);\n                });\n            } else {\n                if (!options.serverId) {\n                    throw new Error('serverId required!');\n                }\n\n                return getItemsForPlayback(options.serverId, {\n          