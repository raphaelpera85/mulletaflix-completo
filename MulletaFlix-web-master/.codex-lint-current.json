  </MenuItem>,\n                <MenuItem\n                    key='admin-metadata-link'\n                    component={Link}\n                    to='/metadata'\n                    onClick={onMenuClose}\n                >\n                    <ListItemIcon>\n                        <Edit />\n                    </ListItemIcon>\n                    <ListItemText primary={globalize.translate('MetadataManager')} />\n                </MenuItem>\n            ])}\n\n            <Divider />\n            {isQuickConnectEnabled && (\n                <MenuItem\n                    component={Link}\n                    to='/quickconnect'\n                    onClick={onMenuClose}\n                >\n                    <ListItemIcon>\n                        <PhonelinkLock />\n                    </ListItemIcon>\n                    <ListItemText>\n                        {globalize.translate('QuickConnect')}\n                    </ListItemText>\n                </MenuItem>\n            )}\n\n            {appHost.supports(AppFeature.MultiServer) && (\n                <MenuItem\n                    onClick={onSelectServerClick}\n                >\n                    <ListItemIcon>\n                        <Storage />\n                    </ListItemIcon>\n                    <ListItemText>\n                        {globalize.translate('SelectServer')}\n                    </ListItemText>\n                </MenuItem>\n            )}\n\n            <MenuItem\n                onClick={onLogoutClick}\n            >\n                <ListItemIcon>\n                    <Logout />\n                </ListItemIcon>\n                <ListItemText>\n                    {globalize.translate('ButtonSignOut')}\n                </ListItemText>\n            </MenuItem>\n\n            {appHost.supports(AppFeature.ExitMenu) && ([\n                <Divider key='exit-menu-divider' />,\n                <MenuItem\n                    key='exit-menu-button'\n                    onClick={onExitAppClick}\n                >\n                    <ListItemIcon>\n                        <Close />\n                    </ListItemIcon>\n                    <ListItemText>\n                        {globalize.translate('ButtonExitApp')}\n                    </ListItemText>\n                </MenuItem>\n            ])}\n        </Menu>\n    );\n};\n\nexport default AppUserMenu;\n","usedDeprecatedRules":[{"ruleId":"no-return-await","replacedBy":[],"info":{"message":"The original assumption of the rule no longer holds true because of engine optimization.","deprecatedSince":"8.46.0","availableUntil":null,"replacedBy":[]}}]},{"filePath":"D:\\Users\\Raphael\\Documents\\Projetos\\mulletaflix\\MulletaFlix-web-master\\src\\components\\toolbar\\ServerButton.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-return-await","replacedBy":[],"info":{"message":"The original assumption of the rule no longer holds true because of engine optimization.","deprecatedSince":"8.46.0","availableUntil":null,"replacedBy":[]}}]},{"filePath":"D:\\Users\\Raphael\\Documents\\Projetos\\mulletaflix\\MulletaFlix-web-master\\src\\components\\toolbar\\UserMenuButton.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-return-await","replacedBy":[],"info":{"message":"The original assumption of the rule no longer holds true because of engine optimization.","deprecatedSince":"8.46.0","availableUntil":null,"replacedBy":[]}}]},{"filePath":"D:\\Users\\Raphael\\Documents\\Projetos\\mulletaflix\\MulletaFlix-web-master\\src\\components\\tunerPicker.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-return-await","replacedBy":[],"info":{"messag