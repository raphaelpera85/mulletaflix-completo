# Local/staging URL used by Playwright and Selenium/Cucumber.
STAGE_URL=http://127.0.0.1:8096

# Test users. Use credentials created only for automated tests.
MFLX_ADMIN_USER=admin
MFLX_ADMIN_PASSWORD=replace-with-a-test-only-password
MFLX_COMMON_USER=mflx-user
MFLX_COMMON_PASSWORD=replace-with-a-test-only-password

# Required only by scenarios that create or browse media libraries.
MFLX_MOVIES_PATH=
MFLX_SERIES_PATH=
MFLX_IPTV_PATH=

# Optional Selenium/Cucumber settings.
SELENIUM_HEADLESS=true
# SELENIUM_CUCUMBER_REPORT_DIR=
# SELENIUM_CUCUMBER_RAW_REPORT=
