<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MulletaFlix.Plugin.GetAvatar</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
<AssemblyVersion>1.6.3.0</AssemblyVersion>
    <FileVersion>1.6.3.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" />
    <!-- Microsoft.AspNetCore.Mvc.Core 2.3.0 transitively requests vulnerable Newtonsoft.Json 9.0.1. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaBrowser.Controller\MediaBrowser.Controller.csproj" />
    <ProjectReference Include="..\Jellyfin.Data\Jellyfin.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\Web\configPage.html" />
    <EmbeddedResource Include="Configuration\Web\configPage.html" />
    <None Remove="Configuration\Web\configPage.js" />
    <EmbeddedResource Include="Configuration\Web\configPage.js" />
    <None Remove="Configuration\Web\userAvatarPage.html" />
    <EmbeddedResource Include="Configuration\Web\userAvatarPage.html" />
    <None Remove="Configuration\Web\clientScript.js" />
    <EmbeddedResource Include="Configuration\Web\clientScript.js" />
    <EmbeddedResource Include="assets\banner.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="$(DefaultItemExcludes)" />
  </ItemGroup>
</Project>
